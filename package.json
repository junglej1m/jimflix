{
  "id": "tflix-engine",
  "name": "Jimflix",
  "version": "1.2.21",
  "type": "extension",
  "description": "Spatial navigation engine for cineby.at / cineby.gd",
  "match": [
    "*://cineby.at/*",
    "*://cineby.gd/*"
  ],
  "run_at": "document_end",
  "js": [
    "TFlixEngine.js"
  ],
  "keys": [
    "Left",
    "Up",
    "Right",
    "Down",
    "Enter",
    "Return",
    "MediaPlayPause",
    "MediaPlay",
    "MediaPause",
    "MediaStop",
    "MediaFastForward",
    "MediaRewind",
    "ColorF0Red",
    "ColorF1Green",
    "ColorF2Yellow",
    "ColorF3Blue",
    "ChannelUp",
    "ChannelDown"
  ]
}
